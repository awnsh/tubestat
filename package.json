{
  "name": "tubestat",
  "private": true,
  "version": "1.0.0",
  "description": "Your YouTube life, tracked. A private, local-first YouTube tracker for Chrome.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-content.mjs",
    "icons": "node scripts/make-logo.mjs",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "license": "MIT",
  "homepage": "https://awnsh.github.io/tubestat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/awnsh/tubestat.git"
  },
  "bugs": "https://github.com/awnsh/tubestat/issues"
}
